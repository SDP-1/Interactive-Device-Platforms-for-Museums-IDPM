# Meshy AI API key for image-to-3D conversion.
# Set your key below for local dev (do not commit real keys), or run:
#   flutter run --dart-define=MESHY_API_KEY=your_key
# Get a key at https://www.meshy.ai/settings/api
MESHY_API_KEY=

# Gemini API key for 2D reconstruction.
GEMINI_API_KEY=

# Optional: custom Gemini image model id.
# GEMINI_MODEL_ID=gemini-2.5-flash-image
